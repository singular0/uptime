<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Log in · Uptime</title>
    <script src="/dashboard/javascripts/colorMode.js"></script>
    <link rel="stylesheet" href="/dashboard/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/dashboard/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="icon" href="/dashboard/favicon.ico">
  </head>
  <body class="bg-body-tertiary">
    <main class="container py-5">
      <div class="row justify-content-center">
        <div class="col-sm-10 col-md-7 col-lg-5">
          <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
              <h1 class="h4 d-flex align-items-center justify-content-center gap-2 mb-3"><i class="bi bi-activity text-primary"></i>Uptime</h1>
              <p class="mb-4"><%= message %></p>
              <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="<%= link.href %>"><i class="bi bi-google"></i> <%= link.text %></a>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
