<div class="col-12">
  <label class="form-label" for="check_http_options">HTTP options</label>
  <textarea id="check_http_options" name="check[http_options]" class="form-control font-monospace" rows="3" placeholder="method: HEAD"><%= check.getPollerParam('http_options') || '' %></textarea>
  <div class="form-text">Request options in YAML. See the
    <% if (check.type === "http") { %>
    <a target="_blank" href="https://nodejs.org/api/http.html#httprequestoptions-callback">Node.js HTTP
    <% } else { %>
    <a target="_blank" href="https://nodejs.org/api/https.html#httpsrequestoptions-callback">Node.js HTTPS
    <% } %>
    documentation</a> for the available options.</div>
</div>
<script>
(function() {
  // grow the textarea with its content
  var textarea = document.getElementById('check_http_options');
  var resize = function() {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + textarea.offsetHeight - textarea.clientHeight + 'px';
  };
  textarea.addEventListener('input', resize);
  resize();
})();
</script>
