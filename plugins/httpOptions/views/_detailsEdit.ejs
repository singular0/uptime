<div class="row mb-3">
  <label class="col-sm-2 col-form-label" for="check_http_options">HTTP Options</label>
  <div class="col-sm-10">
    <textarea id="check_http_options" name="check[http_options]" class="form-control" rows="3" placeholder="Use YAML format, e.g method: HEAD"><%= check.getPollerParam('http_options') || '' %></textarea>
    <div class="form-text">See the
      <% if (check.type === "http") { %>
      <a target="_blank" href="https://nodejs.org/api/http.html#httprequestoptions-callback">Node.js HTTP
      <% } else { %>
      <a target="_blank" href="https://nodejs.org/api/https.html#httpsrequestoptions-callback">Node.js HTTPS
      <% } %>
      documentation</a> for a list of available options</div>
  </div>
</div>
<script>
(function() {
  // grow the textarea with its content
  var textarea = document.getElementById('check_http_options');
  var resize = function() {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + textarea.offsetHeight - textarea.clientHeight + 'px';
  };
  textarea.addEventListener('input', resize);
  resize();
})();
</script>
