<div class="card mb-4">
  <h2 class="card-header h5">Response time</h2>
  <div class="card-body px-4">
    <div id="responseTimeGraph" class="graph adjustedOnDateNavigation"></div>
  </div>
</div>
<script>
jQuery(document).ready(function($) {
  dateInterval.on('refresh-stats', function() {
    drawStatGraph(document.getElementById('responseTimeGraph'), dateInterval, {
      points: dateInterval.stats.map(function(stat) {
        return { x: new Date(stat.timestamp).valueOf(), y: Number(stat.responseTime || stat.time) };
      }),
      color: '--chart-response-time',
      unit: ' ms'
    });
  });
});
</script>
