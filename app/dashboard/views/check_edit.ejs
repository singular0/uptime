<script src="<%= route %>/javascripts/checkState.js"></script>
<div class="d-flex flex-wrap align-items-center gap-3 pb-3 mb-4 border-bottom">
  <div class="me-auto">
    <h1 class="h3 mb-1">Edit check</h1>
    <a class="link-secondary small" href="<%= route %>/checks/<%= check._id %>"><%= check.name %></a>
  </div>
  <span id="checkStatus"></span>
  <% if (check.lastTested) { %>
  <button type="button" class="btn btn-outline-secondary" id="pauseButton"><i class="bi bi-<%= check.isPaused ? 'play-fill' : 'pause-fill' %>"></i> <span><%= check.isPaused ? 'Resume' : 'Pause' %></span></button>
  <% } %>
</div>
<%- partial('_check_details', { check: check, pollerCollection: pollerCollection, pollerDetails: pollerDetails, route: route }) %>
<script>
jQuery(document).ready(function($) {
  // update check state live
  updateCheckState(<%- jsonForScript(check) %>);
  socket.on('CheckEvent', function() {
    $.getJSON('/api/checks/<%= check._id %>', updateCheckState);
  });
  initPauseButton('<%= check._id %>');
});
</script>
