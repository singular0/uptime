<div class="row row-cols-2 row-cols-md-4 g-3 mb-4" id="statCards">
  <div class="col">
    <div class="card stat-card h-100" data-bs-toggle="tooltip" title="Percentage of uptime over the period">
      <div class="card-body">
        <a class="stretched-link link-secondary small" href="#availability">Availability</a>
        <div class="stat-value fs-3 fw-semibold"><span class="availability">–</span><span class="fs-6 fw-normal text-body-secondary">%</span></div>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card h-100" data-bs-toggle="tooltip" title="Total downtime over the period">
      <div class="card-body">
        <a class="stretched-link link-secondary small" href="#events">Downtime</a>
        <div class="stat-value fs-3 fw-semibold downtime">–</div>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card h-100" data-bs-toggle="tooltip" title="Average response time over the period">
      <div class="card-body">
        <a class="stretched-link link-secondary small" href="#responseTime">Response time</a>
        <div class="stat-value fs-3 fw-semibold"><span class="avgRespTime">–</span> <span class="fs-6 fw-normal text-body-secondary">ms</span></div>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card stat-card h-100" data-bs-toggle="tooltip" title="Percentage of pings below the slow threshold over the period">
      <div class="card-body">
        <a class="stretched-link link-secondary small" href="#responsiveness">Responsiveness</a>
        <div class="stat-value fs-3 fw-semibold"><span class="responsiveness">–</span><span class="fs-6 fw-normal text-body-secondary">%</span></div>
      </div>
    </div>
  </div>
</div>
