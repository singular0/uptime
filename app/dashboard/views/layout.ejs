<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Uptime</title>
    <link rel="stylesheet" href="<%= route %>/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="<%= route %>/vendor/bootstrap-icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="<%= route %>/stylesheets/style.css">
    <link rel="icon" href="<%= route %>/favicon.ico">
    <link rel="apple-touch-icon" href="<%= route %>/apple-touch-icon.png">
    <link rel="apple-touch-icon" sizes="72x72" href="<%= route %>/apple-touch-icon-ipad.png">
    <link rel="apple-touch-icon" sizes="114x114" href="<%= route %>/apple-touch-icon-iphone4.png">
    <%- renderCssTags(addedCss) %>
    <script src="<%= route %>/vendor/jquery/jquery.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
    var socket = io(); // connects to the host serving the page
    </script>
    <script src="<%= route %>/vendor/moment/moment.min.js"></script>
    <script src="<%= route %>/vendor/ejs/ejs.min.js"></script>
    <script>
    // client-side templates use {% %} tags, since the server renders the default EJS tags
    ejs.openDelimiter = '{';
    ejs.closeDelimiter = '}';
    </script>
    <script src="<%= route %>/javascripts/safeUrl.js"></script>
  </head>
  <body>
    <div class="container">
      <nav class="navbar navbar-expand bg-dark rounded my-3" data-bs-theme="dark">
        <div class="container-fluid">
          <a class="navbar-brand" href="<%= route %>/events">Uptime</a>
          <ul class="navbar-nav me-auto" id="mainNav">
            <li class="nav-item"><a class="nav-link" href="<%= route %>/events">Events</a></li>
            <li class="nav-item"><a class="nav-link" href="<%= route %>/checks">Checks</a></li>
            <li class="nav-item"><a class="nav-link" href="<%= route %>/tags">Tags</a></li>
            <li class="nav-item" id="new_events"><a class="nav-link" href="<%= route %>/events?highlightFrom=<%= Date.now() %>"></a></li>
          </ul>
          <ul class="navbar-nav" id="check_summary">
            <li class="nav-item" id="all_up" style="display:none;"><span class="badge text-bg-success">Up</span><strong>0</strong></li>
            <li class="nav-item" id="all_down" style="display: none;"><span class="badge text-bg-danger">Down</span><strong>0</strong></li>
          </ul>
        </div>
      </nav>
      <section>
        <%- body %>
      </section>
      <footer class="footer">
        <p class="float-end"><a href="#">Back to top</a></p>
        <p><a href="https://github.com/singular0/uptime">Uptime <%= version %></a>, powered by <a href="https://nodejs.org/">Node.js</a>, <a href="https://www.mongodb.com/">MongoDB</a>, and <a href="https://getbootstrap.com/">Bootstrap</a>.</p>
        <p>Code licensed under the <a href="https://github.com/singular0/uptime/blob/master/LICENSE">MIT License</a>. Check the <a href="https://github.com/singular0/uptime">Uptime GitHub repository</a> regularly for updates.</p>
      </footer>
    </div>
    <script>
    var nbNewEvents = 0;
    var loadedAt = new Date();
    $(document).ready(function() {
      var changeFavicon = function(red) {
        $('head link[rel="icon"]').remove();
        $('head').append('<link rel="icon" href="<%= route %>/favicon' + (red ? '_red' : '') + '.ico">');
      }
      var updateCounts = function() {
        $.getJSON('/api/checks/count', function(count) {
          if (count.total > 0) {
            $('#all_up').show().children('strong').text(count.up);
          } else {
            $('#all_up').hide();
          }
          if (count.down > 0) {
            $('#all_down').show().children('strong').text(count.down);
            changeFavicon(true);
          } else {
            $('#all_down').hide();
            if (nbNewEvents > 0) {
              changeFavicon(false);
            }
          }
          if (nbNewEvents > 0) {
            document.title = '(' + nbNewEvents +') Uptime';
          };
        });
      };
      socket.on('CheckEvent', function() {
        nbNewEvents++;
        updateCounts();
        $('#check_summary').fadeOut().fadeIn().fadeOut().fadeIn();
        $('#new_events a').html(nbNewEvents + ' new event' + (nbNewEvents > 1 ? 's' : '') + ' since ' + moment(loadedAt).format('LLL'));
      });
      updateCounts();
    });
    </script>
  </body>
</html>