<div id="checkEvents" class="list-group list-group-flush"></div>
<script id="event_template" type="text/template">
{% var style = checkEventStyle(event) %}
<div class="list-group-item d-flex align-items-center gap-3{%= highlightFrom && date.valueOf() > highlightFrom ? ' list-group-item-warning' : '' %}">
  <i class="bi {%= style.icon %} text-{%= style.color %} fs-5" role="img" aria-label="{%= style.label %}"></i>
  <div class="flex-grow-1">
    <a href="{%= route + '/checks/' + event.check._id %}">{%= event.check.name %}</a>{% if (isSafeUrl(event.check.url)) { %}&nbsp;<a class="link-secondary" href="{%= event.check.url %}" target="_blank" aria-label="Open {%= event.check.url %}"><i class="bi bi-box-arrow-up-right small"></i></a>{% } %}
    <span class="text-body-secondary">{%= describeCheckEvent(event) %}</span>
  </div>
  <small class="text-body-secondary text-nowrap" data-bs-toggle="tooltip" title="{%= date.format('LLLL') %}">{%= date.format('LT') %}</small>
</div>
</script>
<script id="no_event_template" type="text/template">
<div class="list-group-item text-center text-body-secondary py-5">
  <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
  {%= message %}
</div>
</script>
<script>
$(document).ready(function() {
  var highlightFrom = window.location.search.substring(0,15) == "?highlightFrom=" ? parseInt(window.location.search.substring(15)) : Date.now();
  var event_template = ejs.compile(document.getElementById('event_template').innerHTML);
  var no_event_template = ejs.compile(document.getElementById('no_event_template').innerHTML);
  var adjustHash = function() {
   var hash = window.location.hash;
    if (hash) {
      $(hash).get(0).scrollIntoView();
    }
  };
  var emptyEvents = function() {
    $('#checkEvents').html(no_event_template({ message: <%- jsonForScript(emptyMessage) %> }));
    adjustHash();
  }
  var updateEvents = function() {
    var queryString = typeof dateInterval == 'undefined' ? '' : dateInterval.getIntervalQueryString();
    $.getJSON('<%= url %>' + queryString, function(events) {
      if ($.isEmptyObject(events)) {
        emptyEvents();
        return;
      }
      var lines = [];
      var nbEvents = 0;
      $.each(events, function(key, eventGroup) {
        // keys are dates formatted by the server, so use an event timestamp to get the day
        lines.push('<div class="list-group-item bg-body-tertiary small fw-semibold text-body-secondary">' + moment(eventGroup[0].timestamp).format('dddd, MMMM Do') + '</div>');
        $.each(eventGroup, function(key, event) {
          if (!event.message) return;
          lines.push(event_template({ event: event, date: moment(event.timestamp), highlightFrom: highlightFrom, route: '<%= route %>' }));
          nbEvents++;
        });
      });
      if (nbEvents == 100) {
        lines.push('<div class="list-group-item small text-body-secondary">Only the first 100 events are shown.</div>');
      }
      $('#checkEvents').html(lines.join(''));
      adjustHash();
    });
  }
  socket.on('CheckEvent', updateEvents);
  if(typeof dateInterval != 'undefined') {
    dateInterval.on('refresh-stats', function() {
      if (!this.stat) return emptyEvents();
      var downtime = 0;
      $.each(this.stats, function(index, stat) {
        downtime += stat.downtime || 0; // pings only have a downtime when down
      });
      if (downtime == 0) return emptyEvents();
      updateEvents();
    });
  } else {
    updateEvents();
  }
});
</script>
