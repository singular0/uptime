<script src="<%= route %>/javascripts/sortableTable.js"></script>
<script src="<%= route %>/javascripts/uptimeBar.js"></script>
<script src="<%= route %>/javascripts/checkState.js"></script>
<div class="d-flex flex-wrap align-items-center gap-3 pb-3 mb-4 border-bottom">
  <h1 class="h3 mb-0 me-auto">Checks</h1>
  <span class="small text-body-secondary">Last 24 hours</span>
  <a class="btn btn-primary" href="<%= route %>/checks/new"><i class="bi bi-plus-lg"></i> New check</a>
</div>
<div class="card overflow-hidden">
  <table class="table table-hover align-middle" id="checks">
    <thead>
      <tr>
        <th>Name</th>
        <th>Status</th>
        <th class="w-50" data-bs-toggle="tooltip" title="Outages in the last 24 hours">Uptime</th>
        <th class="text-end" data-bs-toggle="tooltip" title="Average response time in the last 24 hours">Response time</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>
<script id="check_template" type="text/template">
<tr>
  <td data-sort="{%= check.name %}">
    <a href="{%= route + '/checks/' + check._id %}">{%= check.name %}</a>{% if (isSafeUrl(check.url)) { %}&nbsp;<a class="link-secondary" href="{%= check.url %}" target="_blank" aria-label="Open {%= check.url %}"><i class="bi bi-box-arrow-up-right small"></i></a>{% } %}
  </td>
  <td class="text-nowrap" data-sort="{%= !check.lastTested ? 0 : check.isUp ? check.uptime : -check.downtime %}">{%- checkStatusHtml(check) %}</td>
  {% if (check.qos) { %}
  <td data-sort="{%= check.qos.availability %}">
      {%- uptimeBar('check', {
        from: Date.now() - 24 * 60 * 60 * 1000,
        to: Date.now(),
        periods: check.qos.outages || [],
        check: check
       }) %}</td>
  <td class="text-end" data-sort="{%= check.qos.responseTime %}">{%= Math.round(check.qos.responseTime) %} ms</td>
  {% } else { %}
  <td data-sort="0"></td>
  <td class="text-end text-body-secondary" data-sort="0">–</td>
  {% } %}
</tr>
</script>
<script id="no_check_template" type="text/template">
<tr>
  <td colspan="4" class="text-center text-body-secondary py-5">
    No checks yet. <a href="{%= route %}/checks/new">Create your first check</a>.
  </td>
</tr>
</script>
<script>
jQuery(document).ready(function($) {
  // make the check table sortable
  var checksTable = new SortableTable(document.getElementById('checks'), { column: 1 });

  // Fill in the table
  var check_template = ejs.compile(document.getElementById('check_template').innerHTML);
  var no_check_template = ejs.compile(document.getElementById('no_check_template').innerHTML);
  var updateChecks = function(checks) {
    var updateChecksSection = function(checks) {
      var lines = [];
      $.each(checks, function(key, check) {
        lines.push(check_template({ check: check, route: '<%= route %>' }));
      });
      if (!lines.length) {
        lines.push(no_check_template({ route: '<%= route %>' }));
      }
      $('#checks tbody').html(lines.join(''));
      checksTable.sort();
    }

    if (checks) {
      updateChecksSection(checks);
    } else {
      $.getJSON('/api/checks', updateChecksSection);
    }
  }
  updateChecks(<%- jsonForScript(checks) %>);
  socket.on('CheckEvent', function(data) { updateChecks() });
  window.setInterval(updateChecks, 5 * 60 * 1000); // refresh every 5 minutes to update the qos scores
});
</script>
