<h2>Responsiveness</h2>
<div id="responsivenessGraph" class="graph adjustedOnDateNavigation"></div>
<script>
jQuery(document).ready(function($) {
  dateInterval.on('refresh-stats', function() {
    drawStatGraph(document.getElementById('responsivenessGraph'), dateInterval, {
      points: dateInterval.stats.map(function(stat) {
        return { x: new Date(stat.timestamp).valueOf(), y: Number(stat.responsiveness || (stat.isResponsive ? 100 : 0)) };
      }),
      color: '#9440ed',
      unit: '%',
      percent: true
    });
  });
});
</script>
