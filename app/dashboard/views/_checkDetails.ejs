<% addedCss.push('vendor/tagify/tagify.css') %>
<form id="check_form" method="post" action="<%= route %>/checks<%= check.isNew ? '' : '/' + check._id %>">
  <input type="hidden" name="_method" value="<%= (check.isNew) ? 'post' : 'put' %>" />
  <div class="card">
    <div class="card-body vstack gap-4">
      <fieldset>
        <legend class="fs-6 fw-semibold mb-0">Target</legend>
        <div class="row g-3">
          <div class="col-md-8">
            <label class="form-label" for="check_url">URL</label>
            <div class="input-group">
              <input type="url" required id="check_url" name="check[url]" value="<%= check.url || '' %>" class="form-control" placeholder="https://www.example.com" aria-describedby="check_url_help"/>
              <% if (isSafeUrl(check.url)) { %>
              <a class="btn btn-outline-secondary" href="<%= check.url %>" target="_blank" data-bs-toggle="tooltip" title="Open in a new tab" aria-label="Open in a new tab"><i class="bi bi-box-arrow-up-right"></i></a>
              <% } %>
            </div>
            <div class="form-text" id="check_url_help">Without a protocol, http:// is added.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="check_type">Type</label>
            <select id="check_type" name="check[type]" class="form-select" aria-describedby="check_type_help">
              <option value="">auto</option>
              <% pollerCollection.getTypes().forEach(function(poller) { %>
              <option value="<%= poller %>" <% if (poller === check.type) { %> selected <% } %>><%= poller %></option>
              <% }) %>
            </select>
            <div class="form-text" id="check_type_help">Auto picks the type from the URL.</div>
          </div>
          <div class="col-12">
            <label class="form-label" for="check_name">Name</label>
            <input type="text" id="check_name" name="check[name]" value="<%= check.name || '' %>" class="form-control" aria-describedby="check_name_help"/>
            <div class="form-text" id="check_name_help">Leave blank to use the URL.</div>
          </div>
        </div>
      </fieldset>

      <fieldset class="border-top pt-4">
        <legend class="fs-6 fw-semibold mb-0">Polling</legend>
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label" for="check_interval">Interval</label>
            <div class="input-group">
              <input type="number" min="1" step="1" id="check_interval" name="check[interval]" value="<%= (check.interval / 1000).toFixed() %>" class="form-control" aria-describedby="check_interval_help"/>
              <span class="input-group-text">s</span>
            </div>
            <div class="form-text" id="check_interval_help">Time between two pings.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="check_maxTime">Slow threshold</label>
            <div class="input-group">
              <input type="number" min="1" step="1" id="check_maxTime" name="check[maxTime]" value="<%= check.maxTime %>" class="form-control" aria-describedby="check_maxTime_help"/>
              <span class="input-group-text">ms</span>
            </div>
            <div class="form-text" id="check_maxTime_help">Slower responses count as slow.</div>
          </div>
          <div class="col-md-4">
            <label class="form-label" for="check_alertTreshold">Alert threshold</label>
            <div class="input-group">
              <input type="number" min="1" step="1" id="check_alertTreshold" name="check[alertTreshold]" value="<%= check.alertTreshold %>" class="form-control" aria-describedby="check_alertTreshold_help"/>
              <span class="input-group-text">failed pings</span>
            </div>
            <div class="form-text" id="check_alertTreshold_help">Failed pings in a row before the check is down.</div>
          </div>
          <% if (check.lastTested) { %>
          <div class="col-12 small text-body-secondary">
            Last tested <span id="check_lastTested" data-timestamp="<%= check.lastTested.getTime() %>"></span>
          </div>
          <% } %>
        </div>
      </fieldset>

      <fieldset id="pollerFieldset" class="border-top pt-4<%= pollerDetails.trim() ? '' : ' d-none' %>">
        <legend class="fs-6 fw-semibold mb-0">Advanced</legend>
        <div class="row g-3" id="pollerDetails">
        <%- pollerDetails %>
        </div>
      </fieldset>

      <fieldset class="border-top pt-4">
        <legend class="fs-6 fw-semibold mb-0">Tags</legend>
        <div class="row g-3">
          <div class="col-12">
            <label class="visually-hidden" for="check_tags">Tags</label>
            <input type="text" id="check_tags" name="check[tags]" value="<%= check.tags.join(', ') %>" class="form-control" aria-describedby="check_tags_help"/>
            <div class="form-text" id="check_tags_help">Press Enter or type a comma to add a tag. Click a tag to open its page.</div>
          </div>
        </div>
      </fieldset>
    </div>

    <div class="card-footer d-flex flex-wrap gap-2 py-3">
      <% if (check.isNew) { %>
      <button type="submit" class="btn btn-primary">Save</button>
      <button type="submit" name="saveandadd" value="true" class="btn btn-outline-secondary">Save and add another</button>
      <a class="btn btn-outline-secondary" href="<%= route %>/checks">Cancel</a>
      <% } else { %>
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a class="btn btn-outline-secondary" href="<%= route %>/checks/<%= check._id %>">Cancel</a>
      <button type="button" class="btn btn-outline-danger ms-auto" data-bs-toggle="modal" data-bs-target="#deleteModal"><i class="bi bi-trash"></i> Delete</button>
      <% } %>
    </div>
  </div>
</form>
<% if (!check.isNew) { %>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="deleteModalTitle">Delete this check?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        This deletes <strong><%= check.name %></strong> with all its pings and stats. It can't be undone.
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" form="check_form" formnovalidate class="btn btn-danger" id="confirmDelete">Delete check</button>
      </div>
    </div>
  </div>
</div>
<% } %>
<script src="<%= route %>/vendor/tagify/tagify.js"></script>
<script>
// describes the polling interval in minutes once it's a minute or more
function updatePollingIntervalHelp() {
  var seconds = Number($('#check_interval').val());
  var text = 'Time between two pings.';
  if (seconds >= 60) {
    var minutes = Math.round(seconds / 60 * 10) / 10;
    text = (seconds % 60 ? 'About ' : '') + minutes + ' minute' + (minutes === 1 ? '' : 's') + ' between two pings.';
  }
  $('#check_interval_help').text(text);
}
$(document).ready(function() {
  var lastTested = $('#check_lastTested');
  lastTested.text(moment(lastTested.data('timestamp')).format('LLLL'));

  $('#confirmDelete').on('click', function() {
    $('#check_form input[name="_method"]').val('delete');
  });

  updatePollingIntervalHelp();
  $('#check_interval').on('input', updatePollingIntervalHelp);

  $('#check_url').on('blur', function() {
    var field = $(this);
    if (field.val() && field.val().indexOf('://') == -1) {
      field.val('http://' + field.val());
    }
  });

  $('#check_type').on('change', function() {
    var pollerDetails = $('#pollerDetails');
    var show = function(html) {
      pollerDetails.html(html);
      $('#pollerFieldset').toggleClass('d-none', !html.trim());
    };
    $.get('<%= route %>/pollerPartial/' + $(this).val())
      .fail(function() { show(''); })
      .done(show);
  });

  // the server splits tags on commas
  var tagify = new Tagify(document.getElementById('check_tags'), {
    originalInputValueFormat: function(tags) {
      return tags.map(function(tag) { return tag.value; }).join(', ');
    }
  });
  tagify.on('click', function(e) {
    window.location = '<%= route %>/tags/' + encodeURIComponent(e.detail.data.value);
  });
});
</script>
