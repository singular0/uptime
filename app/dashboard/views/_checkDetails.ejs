<% addedCss.push('vendor/tagify/tagify.css') %>
<div id="admin">
  <form id="check_form" method="post" action="<%= route %>/checks<%= check.isNew ? '' : '/' + check._id %>">
    <input type="hidden" name="_method" value="<%= (check.isNew) ? 'post' : 'put' %>" />

    <div class="row">
      <div class="col-md-6">
        <div class="row mb-3">
          <label class="col-sm-4 col-form-label" for="check_url">Url</label>
          <div class="col-sm-8">
            <div class="input-group">
              <input type="text" required id="check_url" name="check[url]" value="<%= check.url || '' %>" class="form-control" placeholder="http://www.example.com"/>
              <% if (isSafeUrl(check.url)) { %>
              <a class="btn btn-outline-secondary" href="<%= check.url %>" target="_blank" title="Open in a new tab"><img src="<%= route %>/images/external-link-ltr-icon.png" alt=""></a>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="row mb-3">
          <label class="col-sm-4 col-form-label" for="check_type">Type</label>
          <div class="col-sm-4">
            <select id="check_type" name="check[type]" class="form-select">
              <option value="">auto</option>
              <% pollerCollection.getTypes().forEach(function(poller) { %>
              <option value="<%= poller %>" <% if (poller === check.type) { %> selected <% } %>><%= poller %></option>
              <% }) %>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label" for="check_name">Name</label>
      <div class="col-sm-10">
        <input type="text" id="check_name" name="check[name]" value="<%= check.name || '' %>" class="form-control" placeholder="Type a name here"/>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="row mb-3">
          <label class="col-sm-4 col-form-label" for="check_interval">Polling interval</label>
          <div class="col-sm-8">
            <div class="input-group">
              <% if (check.lastTested) { %>
              <button type="button" class="btn btn-outline-secondary" name="pause" title="Pause or resume polling"><i class="bi bi-<%= check.isPaused ? 'play-fill' : 'pause-fill' %>"></i></button>
              <% } %>
              <input type="text" id="check_interval" name="check[interval]" value="<%= (check.interval / 1000).toFixed() %>" class="form-control" />
              <span class="input-group-text">s</span>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="row mb-3">
          <label class="col-sm-4 col-form-label" for="check_maxTime">Slow threshold</label>
          <div class="col-sm-5">
            <div class="input-group">
              <input type="text" id="check_maxTime" name="check[maxTime]" value="<%= check.maxTime %>" class="form-control" />
              <span class="input-group-text">ms</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label" for="check_alertTreshold">Alert threshold</label>
      <div class="col-sm-4">
        <div class="input-group">
          <input type="text" id="check_alertTreshold" name="check[alertTreshold]" value="<%= check.alertTreshold %>" class="form-control" />
          <span class="input-group-text">failed pings</span>
        </div>
      </div>
    </div>

    <div id="pollerDetails">
    <%- pollerDetails %>
    </div>

    <div class="row mb-3">
      <label class="col-sm-2 col-form-label" for="check_tags">Tags</label>
      <div class="col-sm-10">
        <input type="text" id="check_tags" name="check[tags]" value="<%= check.tags.join(', ') %>" class="form-control" />
      </div>
    </div>
    <% if (check.lastTested) { %>
    <div class="row mb-3">
      <label class="col-sm-2 col-form-label">Last edited on</label>
      <div class="col-sm-10">
        <span id="check_lastTested" class="form-control-plaintext"><%= check.lastTested.getTime() %></span>
      </div>
    </div>
    <% } %>
    <div class="form-actions">
      <% if (check.isNew) { %>
      <button type="submit" class="btn btn-primary">Save</button>
      <button type="submit" name="saveandadd" value="true" class="btn btn-primary">Save and add</button>
      <a class="btn btn-secondary" href="<%= route %>/checks">Cancel</a>
      <% } else { %>
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a class="btn btn-secondary" href="<%= route %>/checks/<%= check._id %>">Cancel</a>
      <button type="submit" class="btn btn-danger float-end" name="delete">Delete</button>
      <% } %>
    </div>
  </form>
</div>
<script src="<%= route %>/vendor/tagify/tagify.js"></script>
<script>
var intervalFieldSelector = '#check_interval';
function updatePollingIntervalTooltip() {
  var value = $(intervalFieldSelector).val();
  if (value > 60 ) {
    value = (value / 60).toFixed();
    var unit = 'minute' + (value > 1 ? 's' : '');
    $(intervalFieldSelector + ' + span').html('s (' + value + ' ' + unit + ')');
  } else {
    $(intervalFieldSelector + ' + span').html('s');
  }
}
$(document).ready(function() {
  $('#check_lastTested').text(moment(parseInt($('#check_lastTested').text())).format('LLLL'));
  $('#check_form button[name="delete"]').on('click', function() {
    if (!confirm("This will delete the check and related pings and stats.\nAre you sure?")) return false;
    $('#check_form input[name="_method"]').val('delete');
  });
  updatePollingIntervalTooltip();

  $(intervalFieldSelector).on('input', updatePollingIntervalTooltip);

  $('#check_url').on('blur', function() {
    var field = $(this);
    if (field.val() && field.val().indexOf('://') == -1) {
      field.val('http://' + field.val());
    }
  });

  $('#check_type').on('change', function() {
    var pollerDetails = $('#pollerDetails');
    $.get('<%= route %>/pollerPartial/' + $(this).val())
      .fail(function() { pollerDetails.html(''); })
      .done(function(html) { pollerDetails.html(html); });
  });

  // the server splits tags on commas
  var tagify = new Tagify(document.getElementById('check_tags'), {
    originalInputValueFormat: function(tags) {
      return tags.map(function(tag) { return tag.value; }).join(', ');
    }
  });
  tagify.on('click', function(e) {
    window.location = '<%= route %>/tags/' + encodeURIComponent(e.detail.data.value);
  });
});
</script>
