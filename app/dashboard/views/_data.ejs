<div class="card mb-4 overflow-hidden stat d-none">
  <h2 class="card-header h5">Data</h2>
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Date</th>
        <th class="text-end" data-bs-toggle="tooltip" title="Percentage of uptime">Availability</th>
        <th class="text-end" data-bs-toggle="tooltip" title="Total downtime">Downtime</th>
        <th class="text-end" data-bs-toggle="tooltip" title="Percentage of pings below the slow threshold">Responsiveness</th>
        <th class="text-end" data-bs-toggle="tooltip" title="Average response time of all pings">Response time</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>
<div class="card mb-4 overflow-hidden ping d-none">
  <h2 class="card-header h5">Pings</h2>
  <table class="table table-hover">
    <thead>
      <tr>
        <th>Date</th>
        <th>Status</th>
        <th class="text-end">Response time</th>
        <th>Details</th>
        <th>Error</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
</div>
<script id="stat_template" type="text/template">
<tr class="{%= (stat.availability < 100) ? 'row-down' : (stat.responsiveness < 100) ? 'row-slow' : '' %}{%= [0, 6].includes(moment(stat.timestamp).day()) ? ' row-weekend' : '' %}">
  <td><a href="?type={%= subType %}&date={%= stat.timestamp %}" class="date" data-type="{%= subType %}" data-date="{%= stat.timestamp %}">{%= moment(stat.timestamp).format(dateFormat) %}</a></td>
  <td class="text-end">{%= stat.availability.replace('.000', '') %}%</td>
  {% if (stat.downtime) { %}
  <td class="text-end" data-bs-toggle="tooltip" title="{%= stat.downtime %} seconds">{%= formatDowntime(stat.downtime) %}</td>
  {% } else { %}
  <td></td>
  {% } %}
  <td class="text-end">{%= stat.responsiveness.replace('.000', '') %}%</td>
  <td class="text-end">{%= stat.responseTime %} ms</td>
</tr>
</script>
<script id="ping_template" type="text/template">
<tr class="{%= !ping.isUp ? 'row-down' : !ping.isResponsive ? 'row-slow' : '' %}">
  <td class="text-nowrap">{%= moment(ping.timestamp).format('LLLL') %}</td>
  <td>
    <span class="badge {%= (ping.isUp ? 'text-bg-success' : 'text-bg-danger') %}">{%= (ping.isUp ? 'Up' : 'Down') %}</span>
    {% if (ping.isUp && !ping.isResponsive) { %}<span class="badge text-bg-warning">Slow</span>{% } %}
  </td>
  <td class="text-end">{%= parseInt(ping.time) %} ms</td>
  <td>
    {% if (pingHasValidUrl(ping)) { %}
      <a href="{%= ping.details.url %}">See report</a>
    {% } %}
  </td>
  <td class="text-break">{%= ping.error || '' %}</td>
</tr>
</script>
<script>
$(document).ready(function() {
  var pingHasValidUrl = function(ping) {
    return ping.details && isSafeUrl(ping.details.url);
  };
  var stat_template = ejs.compile(document.getElementById('stat_template').innerHTML);
  var ping_template = ejs.compile(document.getElementById('ping_template').innerHTML);
  var updateStats = function() {
    var dateFormats = {
      'day': 'LLLL',
      'month': 'dddd, LL',
      'year': 'MMMM YYYY'
    }
    var type = dateInterval.type;
    var subType = dateInterval.subType(type);
    var stats = dateInterval.stats;
    var lines = [];
    if (type == 'hour') {
      // display pings
      $.each(stats, function(key, stat) {
          lines.unshift(ping_template({ ping: stat, pingHasValidUrl: pingHasValidUrl }));
      });
      $('#data .stat').addClass('d-none');
      $('#data .ping tbody').html(lines.join(''));
      $('#data .ping').removeClass('d-none');
    } else {
      // display aggregated stats
      $.each(stats, function(key, stat) {
        lines.unshift(stat_template({ stat: stat, dateFormat: dateFormats[type], subType: subType }));
      });
      $('#data .ping').addClass('d-none');
      $('#data .stat tbody').html(lines.join(''));
      $('#data .stat').removeClass('d-none');
    }
  }
  dateInterval.on('refresh-stats', updateStats);
  $('#data .stat table').on('click', 'a.date', function(event) {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return; // let the browser open the link
    var data = $(this).data();
    dateInterval.update(data.type, parseInt(data.date));
    return false;
  });
});
</script>
